# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://youdecide.studio
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/youdecide-std/30min
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Public contact address shown in the footer (optional; leave empty to hide)
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: only if you are NOT sending through Gmail (defaults: smtp.gmail.com / 465)
# SMTP_HOST=
# SMTP_PORT=
# Set to "true" ONLY for local previews: shows clearly-labelled DEMO rows
# on the Wall of Trust while there are no real published contributions.
NEXT_PUBLIC_SHOW_DEMO_DATA=false

# ── Supabase ─────────────────────────────────────────
# The browser needs the NEXT_PUBLIC_ pair (admin login). The server also
# accepts SUPABASE_URL / SUPABASE_ANON_KEY if you prefer those names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email via Nodemailer + Gmail SMTP ────────────────
# Gmail account that SENDS the mail, and a Google "App password"
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where enquiries are delivered (can be the same Gmail address)
CONTACT_EMAIL=
# Optional: only if you are NOT sending through Gmail (defaults: smtp.gmail.com / 465)
# SMTP_HOST=
# SMTP_PORT=
